---
import { REPO, strings, type Lang } from '../i18n';
import { Picture } from 'astro:assets';
import { latestPosts } from '../lib/posts';
import avatar from '../assets/avatar.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const posts = await latestPosts(lang);
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
const pad = (n: number) => String(n).padStart(2, '0');
const external = (href: string) => !href.startsWith('mailto:');
---

<div class="page">
  <header class="top rise d0">
    <a class="domain mono" href={lang === 'zh' ? '/zh/' : '/'}>konakona.dev</a>
    <a
      class="switch mono"
      href={t.switchHref}
      hreflang={lang === 'zh' ? 'en' : 'zh-Hans'}
      lang={lang === 'zh' ? 'en' : 'zh-Hans'}>{t.switchLabel}</a
    >
  </header>

  <main>
    <section class="hero">
      <h1 class="wordmark rise d1">
        <span class="l1">kona</span><span class="l2">kona</span>
      </h1>
      <div class="meta rise d3">
        <div class="id">
          <Picture
            src={avatar}
            alt=""
            class="avatar"
            widths={[96, 192, 320, 480]}
            sizes="(max-width: 760px) 6rem, 7.5rem"
            formats={['avif', 'webp']}
            loading="eager"
          />
          <div>
            <p class="name">{t.name}</p>
            <p class="role mono">{t.role}</p>
          </div>
        </div>
        {t.intro.map((p) => <p class="intro">{p}</p>)}
      </div>
    </section>

    <section class="block rise d4" aria-labelledby="works">
      <h2 class="label mono" id="works"><span>§1</span>{t.sections.works}</h2>
      <ol class="works">
        {
          t.works.map((w, i) => (
            <li class="work">
              <span class="idx mono">{pad(i + 1)}</span>
              <div class="work-body">
                <h3>
                  <a class="stretch" href={w.href} rel="noopener">
                    {w.name}
                  </a>
                </h3>
                <p class="kind mono">{w.kind}</p>
                <p class="desc">{w.description}</p>
                {w.links.length > 0 && (
                  <ul class="sub mono">
                    {w.links.map((l) => (
                      <li>
                        <a href={l.href} rel="noopener">
                          {l.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block rise d5" aria-labelledby="writing">
      <h2 class="label mono" id="writing"><span>§2</span>{t.sections.writing}</h2>
      {
        posts.length > 0 ? (
          <ol class="posts">
            {posts.map((p) => (
              <li>
                <time class="mono" datetime={isoDate(p.date)}>
                  {isoDate(p.date)}
                </time>
                <a href={p.href}>{p.title}</a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty">{t.writing.empty}</p>
        )
      }
      <p class="more mono">
        <a href={t.blogHref}>{t.writing.allPosts} →</a>
        <a href={t.feedHref}>{t.writing.feed}</a>
      </p>
    </section>

    <section class="block rise d6" aria-labelledby="elsewhere">
      <h2 class="label mono" id="elsewhere"><span>§3</span>{t.sections.elsewhere}</h2>
      <ul class="elsewhere">
        {
          t.elsewhere.map((l) => (
            <li>
              <a href={l.href} rel={external(l.href) ? 'me noopener' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="colophon mono rise d7">
    <p>© {new Date().getFullYear()} Samuel He</p>
    <p>{t.colophon.built} · <a href={REPO} rel="noopener">{t.colophon.source}</a></p>
  </footer>
</div>
